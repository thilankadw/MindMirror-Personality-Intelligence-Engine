# MindMirror Personality environment template
# Copy this file to `.env` and replace example values where needed.
#
# Notes:
# - `DATABASE_URL` is the main required database setting.
# - `DOCKER_DATABASE_URL` is only needed if container runtime access differs from local access.
# - Kafka and Redis are not part of the active default flow in this repository.

# --------------------------------------------------------------------
# Application identity and runtime
# --------------------------------------------------------------------
ENV=local
APP_NAME=mindmirror-personality
API_V1_PREFIX=/api/v1
API_PORT=8000
LOG_LEVEL=INFO
JSON_LOGS=true

# --------------------------------------------------------------------
# Authentication and security
# Replace `SECRET_KEY` with a strong random value outside local testing.
# --------------------------------------------------------------------
SECRET_KEY=local-dev-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --------------------------------------------------------------------
# Database
# Required for normal runtime.
# Use a standard Postgres URL or Supabase-style URL.
# Example:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/mindmirror?sslmode=require
# --------------------------------------------------------------------
DATABASE_URL=
DOCKER_DATABASE_URL=
DB_CONNECT_TIMEOUT_SECONDS=30
CREATE_TABLES_ON_STARTUP=false

# Local fallback pieces used when `DATABASE_URL` is omitted.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mindmirror
DB_PORT=5432

# --------------------------------------------------------------------
# CORS
# JSON-style list expected by the app.
# Example:
# CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","*"]
# --------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000","*"]

# --------------------------------------------------------------------
# Signup inference worker
# --------------------------------------------------------------------
SIGNUP_SYNC_WAIT_SECONDS=8

# Legacy optional variables kept for rollback/reference only.
# INFERENCE_CONSUMER_GROUP=signup-inference-consumer
# INFERENCE_TOPIC_SIGNUP_REQUESTED=inference.signup.requested
# INFERENCE_TOPIC_SIGNUP_COMPLETED=inference.signup.completed

# --------------------------------------------------------------------
# Reddit API
# Required for live Reddit OAuth and extraction.
# --------------------------------------------------------------------
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=MindMirrorService/1.0.0
REDDIT_OAUTH_SCOPE=identity

# --------------------------------------------------------------------
# Assets and ML paths
# Leave blank to use repository defaults where supported.
# --------------------------------------------------------------------
MINDMIRROR_HOME=
ML_ASSETS_DIR=

# --------------------------------------------------------------------
# MLflow and artifact storage
# Optional for local API-only development, useful for training/export flows.
# --------------------------------------------------------------------
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_ARTIFACT_ROOT=
MLFLOW_FALLBACK_TRACKING_URI=
MODEL_STAGE=

# Optional artifact storage / cloud settings used by some utility flows.
AWS_DEFAULT_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_CONSOLE_SIGNIN_URL=
AWS_IAM_USERNAME=
AWS_CONSOLE_PASSWORD=
AWS_S3=
